# ==============================================================================
# Configuration Modèles LLM (Compatible API OpenAI)
# ==============================================================================
ABES_LLM_URL=https://llm.ilaas.fr/v1
ABES_LLM_KEY=votre_cle_api_llm
ABES_LLM_MODEL=llama-3.1-8b

# LLM Alternatif (Optionnel)
DEEPINFRA_LLM_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_LLM_KEY=
DEEPINFRA_LLM_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# ==============================================================================
# Configuration Base de données vectorielle Qdrant
# ==============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ==============================================================================
# Configuration Serveur FastAPI & Sécurité
# ==============================================================================
API_HOST=0.0.0.0
API_PORT=8071
CORS_ORIGINS=*

# Répertoire racine des données (fichiers csv/pkl)
DATA_DIR=.